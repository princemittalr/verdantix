# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
# Both keys above are FREE tiers (no billing needed). If neither is reachable,
# a free local model (Qwen2.5-1.5B-Instruct on CPU) writes the answer offline.
# Optional: require this X-Token header on POST /api/ingest (IoT sensors) when deployed publicly.
INGEST_TOKEN=
