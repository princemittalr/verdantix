# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
# Both keys above are FREE tiers (no billing needed). If neither is reachable,
# a free local model (Qwen2.5-1.5B-Instruct on CPU) writes the answer offline.
# Access control. On any public deployment set BOTH (long random strings).
# OPERATOR_TOKEN: passcode facilities staff type into "Operator sign-in". Without it, operator checks are OFF locally,
# and in production (Render, or VERDANTIX_ENV=production) every privileged action is REFUSED (fails closed).
OPERATOR_TOKEN=
# MAINTAINER_TOKEN: passcode for the maintainer app (/maintainer): work orders only, no admin actions.
MAINTAINER_TOKEN=
# INGEST_TOKEN: sent by ESP32 sensors / scripts/cctv_agent.py as the X-Token header (falls back to OPERATOR_TOKEN).
INGEST_TOKEN=
# Comma-separated sites allowed to call the API from a browser.
ALLOWED_ORIGINS=https://verdantix-frontend.vercel.app,http://localhost:8000,http://127.0.0.1:8000
# Where records are saved (SQLite). Default: backend/data/state/verdantix.db
VERDANTIX_DB=
# production = fail closed when tokens are missing (set automatically on Render, which sets RENDER=true)
VERDANTIX_ENV=
# Rate-limit client IP: trust Cloudflare's CF-Connecting-IP / True-Client-IP (default on in production)
TRUST_EDGE_HEADERS=
